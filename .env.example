# === 運行模式配置 ===
# SANDBOX = 老虎模擬盤 | PROD = 老虎實盤（強烈建議初期鎖死 SANDBOX）
TRADING_ENV=SANDBOX
# True = 使用內置模擬數據測試介面 | False = 正式連接 Tiger OpenAPI
MOCK_MODE=True

# === 老虎證券 OpenAPI 配置 (TBHK 香港牌照) ===
TIGER_ID=your_tiger_id
TIGER_ACCOUNT=your_account_number
TIGER_LICENSE=TBHK
TIGER_PRIVATE_KEY_PATH=/app/keys/tiger_private_key.pem

# === Gemini AI 配置 ===
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# === Telegram 推播通知（選填） ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 硬性風控紅線參數 ===
MAX_SINGLE_STOCK_PCT=0.50
DEFAULT_WATCHLIST=NVDA,TSLA,QQQ,AAPL